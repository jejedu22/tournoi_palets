# Copier ce fichier en ".env" (même dossier que docker-compose.yml) puis adapter les valeurs :
#   cp .env.exemple .env
# Docker Compose lit automatiquement ".env". Ne jamais commiter ".env".

# ---------------------------------------------------------------------------
# Docker Compose / Traefik
# ---------------------------------------------------------------------------

# OBLIGATOIRE. Nom de domaine public de l'application (sans https://).
# Traefik route les requêtes de ce domaine vers le conteneur.
DOMAIN=palets.exemple.fr

# Nom du résolveur de certificats défini dans la config statique de Traefik
# (celui qui émet les certificats HTTPS). Défaut : letsencrypt
CERT_RESOLVER=letsencrypt

# Nom du réseau Docker partagé avec Traefik (réseau externe, déjà existant).
# Défaut : traefik
TRAEFIK_NETWORK=traefik

# ---------------------------------------------------------------------------
# Envoi d'e-mails (facultatif) : active « Mot de passe oublié ? » sur l'écran de connexion.
# Sans ces réglages, le super-administrateur crée lui-même un lien de réinitialisation
# (page de l'association > « Réinitialiser le mot de passe »).
# Utilisez les paramètres SMTP de votre fournisseur (OVH, Gandi, Brevo, Gmail avec mot de passe d'application…).
# ---------------------------------------------------------------------------

#SMTP_HOST=smtp.exemple.fr
# 587 + STARTTLS (par défaut), ou 465 en TLS direct avec SMTP_SECURE=1
#SMTP_PORT=587
#SMTP_SECURE=0
#SMTP_USER=noreply@exemple.fr
#SMTP_PASS=mot-de-passe-smtp
# Expéditeur affiché (adresse autorisée par votre fournisseur)
#MAIL_FROM=Palets Bretons <noreply@exemple.fr>

# ---------------------------------------------------------------------------
# Application (déjà fixées dans docker-compose.yml / Dockerfile ; à ne modifier
# ici que pour un lancement hors Docker, avec `npm start`)
# ---------------------------------------------------------------------------

# Adresse publique de l'application : liens et QR codes partagés aux joueurs, liens des e-mails
# de réinitialisation. Avec Docker Compose, elle vaut https://<DOMAIN> par défaut.
#PUBLIC_URL=https://palets.exemple.fr

# Port d'écoute. Défaut : 3000 (le compose attend 3000 côté Traefik).
#PORT=3000

# Chemin du fichier SQLite. Défaut : data/tournoi.db (en Docker : /data/tournoi.db, volume "palets-data").
#DB_PATH=data/tournoi.db

# 1 = lit l'IP réelle du visiteur dans X-Forwarded-For (limitation des essais de connexion).
# À n'activer que si l'application n'est joignable QUE via Traefik, sinon l'IP peut être falsifiée.
#TRUST_PROXY=1

# 1 = cookie de session réservé au HTTPS. Mettre 1 dès que le site est servi en HTTPS ;
# laisser vide en développement local en HTTP (sinon la connexion ne tient pas).
#COOKIE_SECURE=1
